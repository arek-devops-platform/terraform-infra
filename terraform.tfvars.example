# Copy this file to terraform.tfvars and fill in real values:
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is listed in .gitignore and must never be committed,
# since it holds values specific to your own Azure environment.

subscription_id      = "00000000-0000-0000-0000-000000000000"
location              = "polandcentral"
resource_group_name   = "rg-app-demo-lab"

# Must be globally unique across all of Azure - letters and numbers only.
acr_name              = "acrappdemolab001"
acr_sku               = "Basic"

aks_cluster_name      = "aks-app-demo-lab"
aks_node_count        = 1
aks_vm_size           = "Standard_B2s"

tags = {
  project     = "app-demo"
  environment = "lab"
  managed_by  = "terraform"
}
